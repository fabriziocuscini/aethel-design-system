{
  "name": "@aethel/ui",
  "version": "0.0.1",
  "private": false,
  "description": "React component library for the Aethel Design System",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --entry src/index.ts",
    "dev": "tsdown --entry src/index.ts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepare": "panda codegen"
  },
  "peerDependencies": {
    "@ark-ui/react": ">=3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@aethel/tokens": "workspace:*",
    "@pandacss/dev": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsdown": "latest",
    "typescript": "latest"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "panda-css",
    "ark-ui"
  ],
  "license": "MIT"
}
