  "cursors": {
    "link": {
      "$type": "other",
      "$value": "pointer",
      "$description": "Cursor for link elements that navigate to another page or location"
    },
    "radio": {
      "$type": "other",
      "$value": "default",
      "$description": "Cursor for radio button and radio card components"
    },
    "button": {
      "$type": "other",
      "$value": "default",
      "$description": "Cursor for buttons and other clickable button elements"
    },
    "switch": {
      "$type": "other",
      "$value": "default",
      "$description": "Cursor for switch toggle components"
    },
    "checkbox": {
      "$type": "other",
      "$value": "default",
      "$description": "Cursor for checkbox and checkbox card components"
    },
    "disabled": {
      "$type": "other",
      "$value": "not-allowed",
      "$description": "Cursor for disabled interactive elements to indicate they are not clickable"
    },
    "menu-item": {
      "$type": "other",
      "$value": "default",
      "$description": "Cursor for menu item and menu option items in dropdown and context menus"
    },
    "slider-thumb": {
      "$type": "other",
      "$value": "grab",
      "$description": "Cursor for slider thumb when hovering, indicating it can be grabbed and dragged"
    },
    "slider-thumb-active": {
      "$type": "other",
      "$value": "grabbing",
      "$description": "Cursor for slider thumb when actively being dragged"
    }
  },
  "durations": {
    "fastest": {
      "$type": "number",
      "$value": "50",
      "$description": "Fastest speed for instant feedback and micro-interactions"
    },
    "faster": {
      "$type": "number",
      "$value": "100",
      "$description": "Faster speed for quick transitions and hover effects"
    },
    "fast": {
      "$type": "number",
      "$value": "150",
      "$description": "Fast speed for snappy transitions on interactive elements"
    },
    "normal": {
      "$type": "number",
      "$value": "200",
      "$description": "Normal (default) speed for standard transitions and animations"
    },
    "slow": {
      "$type": "number",
      "$value": "300",
      "$description": "Slow speed for more noticeable transitions and emphasis"
    },
    "slower": {
      "$type": "number",
      "$value": "400",
      "$description": "Slower speed for deliberate transitions and prominent animations"
    },
    "slowest": {
      "$type": "number",
      "$value": "500",
      "$description": "Slowest speed for very deliberate transitions and dramatic effects"
    }
  },
  "easings": {
    "default": {
      "$type": "string",
      "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
      "$description": "Default easing for smooth, natural transitions and animations"
    },
    "linear": {
      "$type": "string",
      "$value": "linear",
      "$description": "Linear easing for constant speed and minimal acceleration"
    },
    "ease-in": {
      "$type": "string",
      "$value": "cubic-bezier(0.4, 0, 1, 1)",
      "$description": "Easing that starts slow and accelerates to full speed"
    },
    "ease-out": {
      "$type": "string",
      "$value": "cubic-bezier(0, 0, 0.2, 1)",
      "$description": "Easing that starts fast and slows down to a stop"
    },
