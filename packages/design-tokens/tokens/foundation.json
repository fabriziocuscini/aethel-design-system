{
  "blurs": {
    "none": {
      "$type": "dimension",
      "$value": "0px",
      "$description": "No blur for crisp, sharp edges on elements that require maximum clarity"
    },
    "xs": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Extra small blur for ultra-subtle softening on fine details, icons, or delicate layered elements"
    },
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Small blur for gentle softening on subtle UI elements like tooltips or small overlays"
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Medium blur for balanced softness on shadows, card surfaces, or background elements"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Large blur for visible softening on modal backdrops, dropdown menus, or layered components"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Extra large blur for strong softness on glass morphism effects, heavy overlays, or dramatic depth"
    }
  },
