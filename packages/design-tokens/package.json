{
  "name": "@aethel/tokens",
  "version": "0.0.1",
  "private": false,
  "description": "Design tokens for the Aethel Design System",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
